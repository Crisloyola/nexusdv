# Copia este archivo como .env.local (en tu PC) o pon estas variables en Vercel → Settings → Environment Variables.

# true = Nexo responde con IA (preguntas escritas y flujo de venta con chips). false = respuestas fijas (gratis).
# Nunca subas claves al repo: .env.local está en .gitignore.
NEXT_PUBLIC_CHAT_IA=false

# Solo si NEXT_PUBLIC_CHAT_IA=true. Se crea en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opcional: modelo de IA (por defecto claude-haiku-5-5, el más económico)
CHAT_MODEL=claude-haiku-5-5

# Suscripción por correo con el buzón de Hostinger. Completa con los datos SMTP de hPanel.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@nexusdv.pe
SMTP_PASSWORD=75266686*Loyola
